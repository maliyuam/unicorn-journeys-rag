# --- LLM (Anthropic) --------------------------------------------------------
# Leave unset to let the SDK resolve credentials (env var or `ant auth login`).
# With no credentials at all, the app runs in offline extractive mode.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Vector store -----------------------------------------------------------
# auto = MongoDB when MONGODB_URI is set, else local persisted index.
VECTOR_STORE=auto
# The URI contains your database password. Keep it here, in .env, which is
# git-ignored — never in code, and never in .env.example.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=unicorn_rag
MONGODB_COLLECTION=chunks
MONGODB_VECTOR_INDEX=vector_index

# Where the local (non-MongoDB) index is persisted. Override to mount it on a
# container volume, or to run a second instance against a scratch index without
# touching your real corpus.
# INDEX_DIR=/var/lib/unicorn-rag/index

# Where downloaded embedding/reranker models are cached. Defaults to your user
# cache directory. Set it if that is read-only or on a small disk — if the
# cache cannot be written, the engine falls back to TF-IDF and retrieval
# quality drops (it now logs a warning when that happens).
# MODEL_CACHE_DIR=/var/cache/unicorn-rag/models

# --- Embeddings -------------------------------------------------------------
# auto = voyage > fastembed > sentence-transformers > tf-idf (first available)
EMBEDDING_BACKEND=auto
# VOYAGE_API_KEY=pa-...
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-small-en-v1.5

# --- Discovery connectors (YouTube / RSS) -----------------------------------
# Official YouTube Data API v3 key (the paper's approach). Optional — without
# it, discovery uses yt-dlp's keyless search.
# YOUTUBE_API_KEY=AIza...
DISCOVERY_MAX_RESULTS=15
# If YouTube bot-checks your network ("Sign in to confirm you're not a bot"),
# authenticate with your browser session:
# YTDLP_COOKIES_FROM_BROWSER=chrome     # or edge / firefox
# YTDLP_COOKIES_FILE=C:\path\to\cookies.txt
# Local ASR for caption-less audio (pip install faster-whisper):
WHISPER_MODEL=base

# --- Tuning -----------------------------------------------------------------
# Chunking: the word cap also stops unpunctuated ASR transcripts collapsing
# into a single chunk, so do not raise CHUNK_TARGET_WORDS without re-running
# scripts/evaluate.py.
CHUNK_TARGET_WORDS=220
CHUNK_OVERLAP_WORDS=40
DEFAULT_TOP_K=7
REFINE_HALLUCINATION_THRESHOLD=0.02

# Which golden set the evaluation harness scores against (a filename relative
# to data/eval/, or an absolute path). The default set is labelled against a
# real collected corpus and will report broken labels until you have swept that
# media. Use goldens.samples.json to evaluate the bundled sample corpus:
#   EVAL_GOLDENS_FILE=goldens.samples.json python scripts/evaluate.py --retrieval
EVAL_GOLDENS_FILE=goldens.json

# Retrieval fusion depth per sub-query before reciprocal-rank fusion.
# These defaults are the measured optimum on data/eval/goldens.json —
# raising them made retrieval worse (hit@7 0.882 -> 0.824). Re-measure with
# `python scripts/evaluate.py --retrieval` before changing.
FUSION_POOL_MULTIPLIER=1
FUSION_POOL_MIN=10

# Cross-encoder reranking. Fusion finds candidates well but orders them
# poorly; the cross-encoder reads question and passage together. Its ranking
# is BLENDED with fusion's (replacing fusion outright measured worse).
# Set RERANK_ENABLED=0 to skip it — retrieval still works, just less precise.
RERANK_ENABLED=1
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_POOL=40
RERANK_BLEND_K=5
